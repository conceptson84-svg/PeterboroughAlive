---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Flame from '../components/Flame.astro';
---
<Layout path="/404" title="Page not found | Peterborough Alive">
  <Header slot="header" />
  <section class="page-hero" style="border-bottom:0">
    <div class="wrap" style="text-align:center">
      <span class="eyebrow" style="justify-content:center"><Flame /> 404</span>
      <h1 style="font-size:clamp(2.2rem,1.5rem+3vw,3.4rem); margin:.6rem 0">This page has moved on</h1>
      <p class="lede" style="margin:0 auto 1.6rem">We couldn't find that page — but the music's still playing.</p>
      <a class="btn btn-primary" href="/">Back to home</a>
    </div>
  </section>
  <Footer slot="footer" />
</Layout>
