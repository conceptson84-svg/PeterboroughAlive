---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Flame from '../components/Flame.astro';
import { org, nextEvent } from '../data/site';
import { artists, lineupConfirmed } from '../data/artists';
import { partners } from '../data/partners';
import { pastEvents } from '../data/pastEvents';
import heroImg from '../assets/photos/ensemble-finale.jpg';
import watchImg from '../assets/photos/crowd.jpg';

const latest = pastEvents.find((e) => e.gallery.length > 0);
const preview = latest ? latest.gallery.slice(0, 6) : [];
---
<Layout path="/">
  <Header slot="header" />

  <!-- HERO -->
  <section class="hero">
    <Image class="bgimg" src={heroImg} alt="Performers and choir on stage at a Peterborough Alive gospel concert, lit in gold and blue" widths={[768, 1280, 1800]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="wrap">
      <span class="eyebrow"><Flame /> Peterborough's free gospel celebration · Est. {org.established}</span>
      <h1>{org.tagline}</h1>
      <p class="lede">One night, Peterborough gathers across every background and culture for an evening of gospel music, praise and prayer — and everyone's welcome, free of charge.</p>
      <p class="note">{nextEvent.note}</p>

      <div class="eventcard" aria-label="Next event details">
        <div class="ev"><span class="k">Next event</span><span class="v">{nextEvent.title}</span></div>
        <div class="sep" aria-hidden="true"></div>
        <div class="ev"><span class="k">When</span><span class="v">{nextEvent.date || 'Date to be announced'}</span></div>
        <div class="sep" aria-hidden="true"></div>
        <div class="ev"><span class="k">Where</span><span class="v">{nextEvent.venue || nextEvent.city}</span></div>
        {nextEvent.free && <span class="free-tag">Free · All welcome</span>}
      </div>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#lineup">See the lineup</a>
        <a class="btn btn-ghost" href="#watch">▸ Watch last time</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap mission">
      <div>
        <div class="sec-head" style="margin-bottom:1.4rem">
          <span class="eyebrow"><Flame /> Our story</span>
          <h2>A city singing with one voice</h2>
        </div>
        <p class="lede">Peterborough Alive began in {org.established} as a gift to the city from {org.organiser} — a free music event to honour God and bring people together. It grew into a celebration of praise and worship, welcoming artists and neighbours from across Peterborough and beyond.</p>
        <p style="margin-top:1.1rem; color:var(--muted); max-width:60ch">Past stages have hosted Nathaniel Bassey, Philippa Hanna, Faith Child, Lima Blaze and the Peterborough Alive Mass Choir — with room at the front for anyone who simply wants to join in.</p>
      </div>
      <div class="stats" role="list">
        <div class="stat" role="listitem"><div class="n">{org.established}</div><div class="l">Established</div></div>
        <div class="stat" role="listitem"><div class="n">Free</div><div class="l">Entry, every time</div></div>
        <div class="stat" role="listitem"><div class="n">2027</div><div class="l">We return</div></div>
        <div class="stat" role="listitem"><div class="n">All</div><div class="l">Backgrounds welcome</div></div>
      </div>
    </div>
  </section>

  <!-- LINEUP -->
  <section id="lineup" class="tag-alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> The lineup</span>
        <h2>Who's taking the stage</h2>
        <p class="lede">{lineupConfirmed ? 'Your 2027 lineup:' : "The 2027 bill is being confirmed. Here's the calibre of artist Peterborough Alive is known for."}</p>
      </div>
      <div class="lineup-grid">
        {artists.map((a) => (
          <article class="artist">
            <div class="badge">{a.initial}</div>
            <h3>{a.name}</h3>
            <div class="role">{a.role}</div>
            <p>{a.bio}</p>
          </article>
        ))}
      </div>
      {!lineupConfirmed && (
        <span class="soon"><Flame /> Full 2027 lineup announced soon — check back or follow us for updates.</span>
      )}
    </div>
  </section>

  <!-- GALLERY PREVIEW -->
  <section id="gallery">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> Past events</span>
        <h2>Years of full rooms</h2>
        <p class="lede">Relive the nights we've shared since {org.established} — the choirs, the artists, the city on its feet.</p>
      </div>
      {preview.length > 0 && (
        <div class="mosaic">
          {preview.map((photo, i) => (
            <figure class={`m${i}`}>
              <Image src={photo.src} alt={photo.alt} widths={[400, 800]} sizes="(max-width:820px) 50vw, 33vw" loading="lazy" />
              {photo.caption && <figcaption class="cap">{latest?.year} · {photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
      <p style="margin-top:1.8rem"><a class="btn btn-outline" href="/past-events">Browse all past events →</a></p>
    </div>
  </section>

  <!-- WATCH -->
  <section id="watch" class="watch">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> Watch again</span>
        <h2>Couldn't make it? Press play.</h2>
        <p class="lede">Every year we stream and record the night, so the celebration reaches far beyond the room.</p>
      </div>
      <div class="player">
        <Image src={watchImg} alt="The audience at a past Peterborough Alive concert" widths={[768, 1280]} sizes="100vw" loading="lazy" />
        <button class="play" type="button" aria-label="Play the 2023 concert video">
          <span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></span>
        </button>
        <div class="lbl">Peterborough Alive 2023 — Full concert</div>
      </div>
      <p style="margin-top:1rem; color:rgba(255,255,255,.7); font-size:.92rem">Video embed goes here once a YouTube or Facebook link is available.</p>
    </div>
  </section>

  <!-- SPONSORS -->
  <section id="sponsors" class="tag-alt">
    <div class="wrap spon">
      <div>
        <div class="sec-head" style="margin-bottom:1.6rem">
          <span class="eyebrow"><Flame /> Partners &amp; sponsors</span>
          <h2>Made possible together</h2>
        </div>
        <p style="color:var(--muted); max-width:52ch; margin-bottom:1.4rem">Peterborough Alive is powered by local churches, charities and businesses who believe in a city that comes together. We're proud to partner with organisations serving Peterborough all year round.</p>
        <div class="logos">
          {partners.map((p) => (
            <div class="logobox">{p.name}{p.note && <><br />{p.note}</>}</div>
          ))}
        </div>
      </div>
      <div class="sponsor-cta">
        <h3>Become a sponsor</h3>
        <p>Put your organisation in front of thousands of Peterborough families and help keep this night free for everyone. Sponsorship packages available for 2027.</p>
        <a class="btn btn-primary" href="#contact">Request the sponsor pack</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
