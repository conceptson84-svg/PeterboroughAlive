---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Flame from '../components/Flame.astro';
import Video from '../components/Video.astro';
import Contact from '../components/Contact.astro';
import { org, nextEvent, watchVideos } from '../data/site';
import { artists } from '../data/artists';
import { pastEvents } from '../data/pastEvents';
import heroImg from '../assets/hero/h1.jpg';
import slide2 from '../assets/hero/h2.jpg';
import slide3 from '../assets/hero/h3.jpg';
import slide4 from '../assets/hero/h4.jpg';

const latest = pastEvents.find((e) => e.gallery.length > 0);
const preview = latest ? latest.gallery.slice(0, 6) : [];
const heroSlides = [heroImg, slide2, slide3, slide4];
---
<Layout path="/">
  <Header slot="header" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero-slides" aria-hidden="true">
      {heroSlides.map((src, i) => (
        <Image
          class={i === 0 ? 'slide is-active' : 'slide'}
          src={src}
          alt=""
          widths={[1024, 1600, 2560]}
          sizes="100vw"
          quality={82}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : undefined}
        />
      ))}
    </div>
    <div class="wrap">
      <span class="eyebrow"><Flame /> Peterborough's free gospel celebration · Est. {org.established}</span>
      <h1>{org.tagline}</h1>
      <p class="lede">One night, Peterborough gathers across every background and culture for an evening of gospel music, praise and prayer — and everyone's welcome, free of charge.</p>
      <p class="note">{nextEvent.note}</p>

      <div class="eventcard" aria-label="Next event details">
        <div class="ev"><span class="k">Next event</span><span class="v">{nextEvent.title}</span></div>
        <div class="sep" aria-hidden="true"></div>
        <div class="ev"><span class="k">When</span><span class="v">{nextEvent.date || 'Date to be announced'}</span></div>
        <div class="sep" aria-hidden="true"></div>
        <div class="ev"><span class="k">Where</span><span class="v">{nextEvent.venue || nextEvent.city}</span></div>
        {nextEvent.free && <span class="free-tag">Free · All welcome</span>}
      </div>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#lineup">See the lineup</a>
        <a class="btn btn-ghost" href="#watch">▸ Watch last time</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <div class="wrap mission">
      <div>
        <div class="sec-head" style="margin-bottom:1.4rem">
          <span class="eyebrow"><Flame /> Our story</span>
          <h2>A city singing with one voice</h2>
        </div>
        <p class="lede">From the very first night in {org.established}, Peterborough Alive has carried one mandate: to be a voice of unity, transformation, love, joy and hope in a community as diverse as Peterborough — and to carry it through the gift of music.</p>
        <p style="margin-top:1.1rem; color:var(--muted); max-width:60ch">It began at the Broadway Theatre, moved to The Cresset, held on through the pandemic, and came back to fuller rooms than ever. Our stages have welcomed Noel Robinson, Philippa Hanna, Nathaniel Bassey, Faith Child, the Sienna Gospel Choir and the Peterborough Alive Mass Choir — always with room at the front for anyone who simply wants to join in.</p>
      </div>
      <div class="stats" role="list">
        <div class="stat" role="listitem"><div class="n">{org.established}</div><div class="l">Established</div></div>
        <div class="stat" role="listitem"><div class="n">Free</div><div class="l">Entry, every time</div></div>
        <div class="stat" role="listitem"><div class="n">2027</div><div class="l">We return</div></div>
        <div class="stat" role="listitem"><div class="n">All</div><div class="l">Backgrounds welcome</div></div>
      </div>
    </div>
  </section>

  <!-- QUOTE -->
  <section class="quote-band">
    <svg class="qb-blob qb-blob-a" viewBox="0 0 200 200" aria-hidden="true"><g transform="translate(100,100)"><path d="M38.8,-52.9C51.5,-44.1,63.6,-33.5,68.1,-20.1C72.6,-6.7,69.5,9.5,62.1,23.3C54.7,37.1,43,48.5,29.1,55.9C15.2,63.3,-0.9,66.7,-16.3,63.4C-31.7,60.1,-46.4,50.1,-56.3,36.4C-66.2,22.7,-71.3,5.3,-68.4,-10.7C-65.5,-26.7,-54.6,-41.3,-41.2,-50.1C-27.8,-58.9,-13.9,-61.9,-0.3,-61.5C13.3,-61.1,26.1,-61.7,38.8,-52.9Z"/></g></svg>
    <svg class="qb-blob qb-blob-b" viewBox="0 0 200 200" aria-hidden="true"><g transform="translate(100,100)"><path d="M44.1,-59.6C56.5,-50.4,64.9,-36.3,68.9,-21.1C72.9,-5.9,72.5,10.4,66.3,24.1C60.1,37.8,48.1,48.9,34.4,56.6C20.7,64.3,5.3,68.6,-10.9,68.1C-27.1,67.6,-44.1,62.3,-55.7,51.1C-67.3,39.9,-73.5,22.8,-73.9,5.6C-74.3,-11.6,-68.9,-28.9,-58.3,-41.8C-47.7,-54.7,-31.9,-63.2,-15.7,-65.8C0.5,-68.4,17.1,-65.1,44.1,-59.6Z"/></g></svg>
    <div class="wrap">
      <Flame class="q-flame" />
      <blockquote>
        <p>“Not just a night of songs, but a love-experience — an opportunity for renewed hope, a transformation you won’t forget in a hurry.”</p>
        <cite>From a Peterborough Alive welcome address</cite>
      </blockquote>
    </div>
  </section>

  <!-- LINEUP -->
  <section id="lineup" class="tag-alt">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> The artists</span>
        <h2>Artists who've graced our stage</h2>
        <p class="lede">A taste of the artists Peterborough Alive has been honoured to host over the years. The 2027 lineup will be announced here — follow us for updates.</p>
      </div>
      <div class="lineup-grid">
        {artists.map((a) => (
          <article class="artist">
            <div class="badge">{a.initial}</div>
            <h3>{a.name}</h3>
            <div class="role">{a.role}</div>
            <p>{a.bio}</p>
          </article>
        ))}
      </div>
      <div class="sing-cta">
        <div>
          <h3>Sing with us in 2027</h3>
          <p>The Peterborough Alive Mass Choir is open to voices from across the city — no audition, just a heart to sing. Add yours for 2027.</p>
        </div>
        <a class="btn btn-primary" href="#contact" data-enquiry="Sing with the Mass Choir">Sing with the choir</a>
      </div>
    </div>
  </section>

  <!-- GALLERY PREVIEW -->
  <section id="gallery">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> Past events</span>
        <h2>Years of full rooms</h2>
        <p class="lede">Relive the nights we've shared since {org.established} — the choirs, the artists, the city on its feet.</p>
      </div>
      {preview.length > 0 && (
        <div class="mosaic">
          {preview.map((photo, i) => (
            <figure class={`m${i}`}>
              <Image src={photo.src} alt={photo.alt} widths={[500, 900, 1400]} sizes="(max-width:820px) 50vw, 33vw" quality={80} loading="lazy" />
              {photo.caption && <figcaption class="cap">{latest?.year} · {photo.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
      <p style="margin-top:1.8rem"><a class="btn btn-outline" href="/past-events">Browse all past events →</a></p>
    </div>
  </section>

  <!-- WATCH -->
  <section id="watch" class="watch">
    <div class="wrap">
      <div class="sec-head">
        <span class="eyebrow"><Flame /> Watch again</span>
        <h2>Couldn't make it? Press play.</h2>
        <p class="lede">Every year we stream and record the night, so the celebration reaches far beyond the room.</p>
      </div>
      <div class="watch-grid">
        {watchVideos.map((v) => <Video id={v.id} title={v.title} />)}
      </div>
      <p style="margin-top:1.4rem">
        <a class="btn btn-ghost" href="https://www.youtube.com/@peterboroughalive8603" target="_blank" rel="noopener noreferrer">▸ More on YouTube</a>
      </p>
    </div>
  </section>

  <!-- SPONSORS -->
  <section id="sponsors" class="tag-alt">
    <div class="wrap spon">
      <div>
        <div class="sec-head" style="margin-bottom:1.6rem">
          <span class="eyebrow"><Flame /> Partners &amp; sponsors</span>
          <h2>Made possible together</h2>
        </div>
        <p style="color:var(--muted); max-width:52ch">Peterborough Alive is powered by local churches, charities and businesses who believe in a city that comes together. Organised by {org.organiser}, we partner with organisations serving Peterborough all year round.</p>
      </div>
      <div class="sponsor-cta">
        <h3>Become a sponsor</h3>
        <p>Put your organisation in front of thousands of Peterborough families and help keep this night free for everyone. Sponsorship packages available for 2027.</p>
        <a class="btn btn-primary" href="#contact" data-enquiry="Sponsorship">Request the sponsor pack</a>
      </div>
    </div>
  </section>

  <Contact />

  <script is:inline>
    (function () {
      var slides = document.querySelectorAll('.hero-slides .slide');
      if (slides.length < 2) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var i = 0;
      setInterval(function () {
        slides[i].classList.remove('is-active');
        i = (i + 1) % slides.length;
        slides[i].classList.add('is-active');
      }, 5000);
    })();
  </script>

  <Footer slot="footer" />
</Layout>
